# ==============================================================================
# FPL TEAM OPTIMIZER & TRANSFER PLANNER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (without .example extension) in the same directory:
#   cp .env.example .env
#
# IMPORTANT: The '.env' file is listed in .gitignore and will NOT be tracked or read by AI agents.

# 1. Default FPL Team ID (Found in your FPL URL: https://fantasy.premierleague.com/entry/YOUR_TEAM_ID/history)
FPL_TEAM_ID=1234567

# 2. (Optional) Official FPL Login Credentials for private endpoints (e.g. My Team / Transfer submission)
FPL_EMAIL=your_email@example.com
FPL_PASSWORD=your_fpl_password

# 3. Backend Server Configuration
HOST=127.0.0.1
PORT=8000
